# Android fstab file for Lenovo IdeaTab Pro Gen 2 (malbec / TB390FU)
# mount_point   fstype  device                                      flags

# Dynamic Partitions (super)
system          ext4    /dev/block/mapper/system                     flags=display="System";logical;slotselect
system_ext      ext4    /dev/block/mapper/system_ext                 flags=display="System EXT";logical;slotselect
vendor          ext4    /dev/block/mapper/vendor                     flags=display="Vendor";logical;slotselect;first_stage_mount
product         ext4    /dev/block/mapper/product                    flags=display="Product";logical;slotselect
odm             ext4    /dev/block/mapper/odm                        flags=display="ODM";logical;slotselect
vendor_dlkm     ext4    /dev/block/mapper/vendor_dlkm                flags=display="Vendor DLKM";logical;slotselect;first_stage_mount

# Physical Partitions
/boot           emmc    /dev/block/bootdevice/by-name/boot           flags=display="Boot";slotselect;backup=1
/recovery       emmc    /dev/block/bootdevice/by-name/recovery       flags=display="Recovery";slotselect;backup=1
/vendor_boot    emmc    /dev/block/bootdevice/by-name/vendor_boot    flags=display="Vendor Boot";slotselect;backup=1
/init_boot      emmc    /dev/block/bootdevice/by-name/init_boot      flags=display="Init Boot";slotselect;backup=1
/dtbo           emmc    /dev/block/bootdevice/by-name/dtbo           flags=display="DTBO";slotselect;backup=1
/vbmeta         emmc    /dev/block/bootdevice/by-name/vbmeta         flags=display="VBMeta";slotselect;backup=1
/vbmeta_system  emmc    /dev/block/bootdevice/by-name/vbmeta_system  flags=display="VBMeta System";slotselect;backup=1
/modem          emmc    /dev/block/bootdevice/by-name/modem          flags=display="Modem";slotselect;backup=1
/bluetooth      emmc    /dev/block/bootdevice/by-name/bluetooth      flags=display="Bluetooth";slotselect;backup=1
/dsp            emmc    /dev/block/bootdevice/by-name/dsp            flags=display="DSP";slotselect;backup=1
/persist        ext4    /dev/block/bootdevice/by-name/persist         flags=display="Persist";backup=1
/metadata       ext4    /dev/block/bootdevice/by-name/metadata        flags=display="Metadata"

# Userdata
/data           f2fs    /dev/block/bootdevice/by-name/userdata        flags=display="Data"

# External storage
/sdcard1        auto    /dev/block/mmcblk0p1                          flags=display="MicroSD";storage;wipeingui;removable
/usb_otg        auto    /dev/block/sda1                               flags=display="USB OTG";storage;wipeingui;removable
